generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CourseRecords {
  id         Int      @id @default(autoincrement())
  FirstName  String
  LastName   String
  Email      String
  CourseName String
  Code       String
  StartDate  DateTime
  Progress   Int
}


