generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model CourseRecords {
  id         Int      @id @default(autoincrement())
  FirstName  String
  LastName   String
  Email      String
  CourseName String
  Code       String
  StartDate  DateTime
  Progress   Int
}
