generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model CourseRecords {
  id         Int       @id @default(autoincrement())
  FirstName  String
  LastName   String
  Email      String
  CourseName String
  Code       String    @unique
  StartDate  DateTime
  EndDate    DateTime?
  Test1      Int
  Test2      Int
  Test3      Int
  Test4      Int
  Test5      Int
  Test6      Int
  Test7      Int
  Test8      Int
  Progress   Int
  SlidesPath String?
}

model MasonCourse {
  id          Int            @id @default(autoincrement())
  title       String
  slug        String         @unique
  description String?
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sections    MasonSection[]
}

model MasonSection {
  id          Int         @id @default(autoincrement())
  courseId    Int
  title       String
  position    Int
  fileName    String
  mimeType    String      @default("application/pdf")
  pdfData     Bytes
  lessonPlan  Json
  createdAt   DateTime    @default(now())
  course      MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}
