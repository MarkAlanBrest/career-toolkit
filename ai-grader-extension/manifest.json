{
  "manifest_version": 3,
  "name": "AI Grader for Canvas",
  "version": "1.0.0",
  "description": "AI-assisted SpeedGrader toolbar for Canvas LMS — AI grading, grading criteria, comment snippets, and a cheating-detection audit, using your own Claude API key.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.com/*",
    "https://*.canvaslms.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.com/*",
        "https://*.canvaslms.com/*"
      ],
      "js": ["lib/pdf.min.js", "lib/mammoth.browser.min.js", "lib/jszip.min.js", "lib/pdf-lib.min.js", "ai-grader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.worker.min.js"],
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.com/*",
        "https://*.canvaslms.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
