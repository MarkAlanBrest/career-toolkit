      "items": [
        { "label": "Grading breakdown",    "html": "<table style=\"width:100%;border-collapse:collapse;margin:1em 0;\"><thead><tr style=\"background:#333;color:#fff;\"><th style=\"padding:10px 12px;text-align:left;\">Category</th><th style=\"padding:10px 12px;text-align:center;\">Weight</th><th style=\"padding:10px 12px;text-align:center;\">Points</th></tr></thead><tbody><tr style=\"background:#f9f9f9;\"><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Assignments</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">40%</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">400</td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Quizzes</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">30%</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">300</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Participation</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">20%</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">200</td></tr><tr style=\"font-weight:bold;background:#f0f4f8;\"><td style=\"padding:9px 12px;\">Final Exam</td><td style=\"padding:9px 12px;text-align:center;\">10%</td><td style=\"padding:9px 12px;text-align:center;\">100</td></tr></tbody></table>" },
        { "label": "Point breakdown",      "html": "<table style=\"width:100%;border-collapse:collapse;margin:1em 0;\"><thead><tr style=\"background:#0770B8;color:#fff;\"><th style=\"padding:10px 12px;text-align:left;\">Component</th><th style=\"padding:10px 12px;text-align:center;\">Points</th></tr></thead><tbody><tr style=\"background:#f9f9f9;\"><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Component 1</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">25</td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Component 2</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">25</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Component 3</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">50</td></tr><tr style=\"font-weight:bold;background:#f0f4f8;\"><td style=\"padding:9px 12px;\">Total</td><td style=\"padding:9px 12px;text-align:center;\">100</td></tr></tbody></table>" },
        { "label": "Submission checklist", "html": "<div style=\"background:#f0f4f8;border-radius:4px;padding:16px;margin:1em 0;\"><strong style=\"display:block;margin-bottom:10px;\">✅ Before You Submit</strong><ul style=\"list-style:none;padding:0;margin:0;\"><li style=\"padding:6px 0;border-bottom:1px solid #ddd;\">☐ Requirement one</li><li style=\"padding:6px 0;border-bottom:1px solid #ddd;\">☐ Requirement two</li><li style=\"padding:6px 0;border-bottom:1px solid #ddd;\">☐ Requirement three</li><li style=\"padding:6px 0;\">☐ Requirement four</li></ul></div>" },
        { "label": "Self-assessment",      "html": "<div style=\"border:1px solid #ddd;border-radius:4px;padding:16px;margin:1em 0;\"><strong style=\"display:block;margin-bottom:12px;\">🔍 Self-Assessment</strong><table style=\"width:100%;border-collapse:collapse;\"><thead><tr style=\"background:#f0f4f8;\"><th style=\"padding:8px 12px;text-align:left;font-weight:600;\">Skill / Outcome</th><th style=\"padding:8px 12px;text-align:center;font-weight:600;\">Not Yet</th><th style=\"padding:8px 12px;text-align:center;font-weight:600;\">Developing</th><th style=\"padding:8px 12px;text-align:center;font-weight:600;\">Proficient</th><th style=\"padding:8px 12px;text-align:center;font-weight:600;\">Mastered</th></tr></thead><tbody><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;\">Skill one</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">☐</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">☐</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">☐</td><td style=\"padding:9px 12px;border-bottom:1px solid #eee;text-align:center;\">☐</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:9px 12px;\">Skill two</td><td style=\"padding:9px 12px;text-align:center;\">☐</td><td style=\"padding:9px 12px;text-align:center;\">☐</td><td style=\"padding:9px 12px;text-align:center;\">☐</td><td style=\"padding:9px 12px;text-align:center;\">☐</td></tr></tbody></table></div>" }
