        { "label": "Module Introduction", "html": "<div style=\"font-family:sans-serif;\"><div style=\"background:linear-gradient(to right,{{P}},{{P}}99);color:#fff;padding:20px 24px;border-radius:4px 4px 0 0;\"><div style=\"font-size:.85em;opacity:.8;margin-bottom:4px;\">Module [#]</div><strong style=\"font-size:1.4em;\">Module Title</strong></div><div style=\"border:1px solid #ddd;border-top:none;padding:20px;border-radius:0 0 4px 4px;\"><p><strong>Overview</strong><br>Describe what this module covers.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><div style=\"background:{{L}};border-left:4px solid {{P}};padding:10px 14px;margin-bottom:16px;\"><strong>🎯 Learning Objectives</strong><ul style=\"margin:8px 0 0 0;\"><li>Objective one</li><li>Objective two</li><li>Objective three</li></ul></div><p><strong>📅 What's Due</strong></p><ul><li>Read: [Chapter / Article]</li><li>Complete: [Assignment]</li><li>Participate: [Discussion]</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>⏱ Estimated Time:</strong> [#] hours</p></div></div>", "colorable": true },
        { "label": "Discussion Prompt",  "html": "<div style=\"font-family:sans-serif;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:{{P}};color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">💬 Discussion: [Topic]</strong><br><span style=\"font-size:.85em;opacity:.8;\">Due: [Date] | Min. [#] replies</span></div><div style=\"padding:20px;\"><p><strong>Prompt</strong><br>Write your discussion question here.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Requirements</strong></p><ul><li>Initial post: [#] words minimum by [date]</li><li>Reply to at least [#] classmates by [date]</li></ul><div style=\"background:{{L}};border-left:4px solid {{P}};padding:10px 14px;margin-top:16px;\"><strong>Grading:</strong> [#] points</div></div></div>", "colorable": true },
        { "label": "Assignment Brief",   "html": "<div style=\"font-family:sans-serif;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:{{P}};color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">Assignment Title</strong><br><span style=\"font-size:.85em;opacity:.8;\">Due: [Date] | Points: [#]</span></div><div style=\"padding:20px;\"><p><strong>Overview</strong><br>Brief description.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Instructions</strong></p><ol><li>Step one</li><li>Step two</li><li>Step three</li></ol><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Submission</strong><br>How to submit.</p></div></div>", "colorable": true },
