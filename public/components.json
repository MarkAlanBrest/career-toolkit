    "templates": {
      "label": "Templates",
      "icon": "📄",
      "items": [
        { "label": "Weekly Lesson",      "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;\"><div style=\"background:#0770B8;color:#fff;padding:16px 20px;border-radius:4px 4px 0 0;\"><strong style=\"font-size:1.2em;\">Week [#] — Lesson Title</strong></div><div style=\"border:1px solid #ddd;border-top:none;padding:20px;border-radius:0 0 4px 4px;\"><div style=\"background:#e3f2fd;border-left:4px solid #0770B8;padding:10px 14px;margin-bottom:16px;\"><strong>🎯 Objectives</strong><br>By the end of this lesson, students will be able to:<ul style=\"margin:8px 0 0 0;\"><li>Objective one</li><li>Objective two</li></ul></div><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><strong>📖 Content</strong><p>Lesson content goes here.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><strong>📝 Assignment</strong><p>Assignment details go here.</p></div></div>" },
        { "label": "Module Introduction", "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;\"><div style=\"background:linear-gradient(to right,#0770B8,#4db6f0);color:#fff;padding:20px 24px;border-radius:4px 4px 0 0;\"><div style=\"font-size:.85em;opacity:.8;margin-bottom:4px;\">Module [#]</div><strong style=\"font-size:1.4em;\">Module Title</strong></div><div style=\"border:1px solid #ddd;border-top:none;padding:20px;border-radius:0 0 4px 4px;\"><p><strong>Overview</strong><br>Describe what this module is about and how it fits into the course.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><div style=\"background:#e3f2fd;border-left:4px solid #0770B8;padding:10px 14px;margin-bottom:16px;\"><strong>🎯 Learning Objectives</strong><ul style=\"margin:8px 0 0 0;\"><li>Objective one</li><li>Objective two</li><li>Objective three</li></ul></div><p><strong>📅 What's Due This Module</strong></p><ul><li>Read: [Chapter / Article]</li><li>Complete: [Assignment name]</li><li>Participate: [Discussion name]</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>⏱ Estimated Time: </strong>[#] hours</p></div></div>" },
        { "label": "Discussion Prompt",  "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#5c2d91;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">💬 Discussion: [Topic]</strong><br><span style=\"font-size:.85em;opacity:.8;\">Due: [Date] &nbsp;|&nbsp; Min. [#] replies</span></div><div style=\"padding:20px;\"><p><strong>Prompt</strong><br>Write your discussion question here.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Requirements</strong></p><ul><li>Initial post: [#] words minimum by [date]</li><li>Reply to at least [#] classmates by [date]</li><li>Use evidence or examples to support your points</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><div style=\"background:#e3f2fd;border-left:4px solid #0770B8;padding:10px 14px;\"><strong>Grading: </strong>This discussion is worth [#] points.</div></div></div>" },
        { "label": "Assignment Brief",   "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#333;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">Assignment Title</strong><br><span style=\"font-size:.85em;opacity:.8;\">Due: [Date] &nbsp;|&nbsp; Points: [#]</span></div><div style=\"padding:20px;\"><p><strong>Overview</strong><br>Brief description of what students will do.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Instructions</strong></p><ol><li>Step one</li><li>Step two</li><li>Step three</li></ol><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Submission</strong><br>Describe how students should submit their work.</p></div></div>" },
        { "label": "Project Brief",      "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#4a148c;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">🗂 Project: [Title]</strong><br><span style=\"font-size:.85em;opacity:.8;\">Due: [Date] &nbsp;|&nbsp; Points: [#]</span></div><div style=\"padding:20px;\"><p><strong>Overview</strong><br>Brief description of the project and its purpose.</p><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Deliverables</strong></p><ul><li>Deliverable one</li><li>Deliverable two</li><li>Deliverable three</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>📅 Timeline</strong></p><table style=\"width:100%;border-collapse:collapse;\"><tr style=\"background:#f0f4f8;\"><th style=\"padding:8px 12px;text-align:left;\">Milestone</th><th style=\"padding:8px 12px;text-align:left;\">Due Date</th></tr><tr><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Topic approval</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">[Date]</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Draft submission</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">[Date]</td></tr><tr><td style=\"padding:8px 12px;\">Final submission</td><td style=\"padding:8px 12px;\">[Date]</td></tr></table></div></div>" },
        { "label": "Study Guide",        "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#1a237e;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">📚 Study Guide — [Topic / Exam]</strong></div><div style=\"padding:20px;\"><div style=\"background:#fffde7;border-left:4px solid #f9a825;padding:10px 14px;margin-bottom:16px;\"><strong>📅 Exam Date:</strong> [Date] &nbsp;|&nbsp; <strong>Format:</strong> [Type]</div><p><strong>Key Topics</strong></p><ul><li>Topic one</li><li>Topic two</li><li>Topic three</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Key Terms</strong></p><table style=\"width:100%;border-collapse:collapse;\"><tr style=\"background:#f0f4f8;\"><th style=\"padding:8px 12px;text-align:left;\">Term</th><th style=\"padding:8px 12px;text-align:left;\">Definition</th></tr><tr><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Term 1</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Definition here</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:8px 12px;\">Term 2</td><td style=\"padding:8px 12px;\">Definition here</td></tr></table><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Practice Questions</strong></p><ol><li>Practice question one</li><li>Practice question two</li><li>Practice question three</li></ol></div></div>" },
        { "label": "Peer Review Guide",  "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#00695c;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">🔄 Peer Review Instructions</strong></div><div style=\"padding:20px;\"><div style=\"background:#e8f5e9;border-left:4px solid #2e7d32;padding:10px 14px;margin-bottom:16px;\"><strong>You will review [#] classmates' work.</strong> Be specific, constructive, and respectful.</div><p><strong>Review Criteria</strong></p><table style=\"width:100%;border-collapse:collapse;\"><thead><tr style=\"background:#f0f4f8;\"><th style=\"padding:8px 12px;text-align:left;\">Criterion</th><th style=\"padding:8px 12px;text-align:left;\">What to Look For</th></tr></thead><tbody><tr><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Content</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Is the argument clear and supported?</td></tr><tr style=\"background:#f9f9f9;\"><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Organization</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">Is it well-structured and easy to follow?</td></tr><tr><td style=\"padding:8px 12px;\">Evidence</td><td style=\"padding:8px 12px;\">Are sources cited and relevant?</td></tr></tbody></table><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Feedback Guidelines</strong></p><ul><li>Start with one strength you noticed</li><li>Identify one area for improvement with a specific suggestion</li><li>End with an encouraging closing comment</li></ul></div></div>" },
        { "label": "Lab Instructions",   "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#1b5e20;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">🔬 Lab: [Title]</strong></div><div style=\"padding:20px;\"><div style=\"background:#fff3e0;border-left:4px solid #e65100;padding:10px 14px;margin-bottom:16px;\"><strong>⚠️ Safety</strong><br>List safety requirements here.</div><p><strong>Materials Needed</strong></p><ul><li>Item one</li><li>Item two</li></ul><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Procedure</strong></p><ol><li>Step one</li><li>Step two</li><li>Step three</li></ol><hr style=\"border:none;border-top:1px solid #eee;margin:16px 0;\"><p><strong>Questions / Reflection</strong></p><ol><li>Question one</li><li>Question two</li></ol></div></div>" },
        { "label": "Announcement",       "html": "<div style=\"font-family:sans-serif;max-width:800px;margin:0 auto;border:1px solid #ddd;border-radius:4px;overflow:hidden;\"><div style=\"background:#e65100;color:#fff;padding:16px 20px;\"><strong style=\"font-size:1.2em;\">📢 Announcement</strong><br><span style=\"font-size:.85em;opacity:.8;\">[Date]</span></div><div style=\"padding:20px;\"><p>Write your announcement here. Keep it brief and action-oriented.</p><div style=\"background:#fff3e0;border-left:4px solid #e65100;padding:10px 14px;margin-top:16px;\"><strong>Action Required:</strong> Describe what students need to do, if anything.</div></div></div>" }
