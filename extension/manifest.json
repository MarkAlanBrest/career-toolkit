{
  "manifest_version": 3,
  "name": "Canvas Enhancer",
  "version": "2.4.1",
  "description": "Add professionally styled components, AI-generated content, and quizzes to your Canvas LMS pages.",
  "permissions": [
    "storage",
    "cookies",
    "windows",
    "management"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.com/*",
    "https://*.canvaslms.com/*",
    "https://canvasenhancer.com/*",
    "https://*.amazonaws.com/*",
    "https://api.anthropic.com/*",
    "https://api.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.com/*",
        "https://*.canvaslms.com/*"
      ],
      "js": ["backup.js", "canvas-token.js", "hub.js", "content.js", "grader.js", "scheduler.js", "email.js", "announcements.js", "date-autofill.js", "module-builder.js"],
      "css": ["toolbar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
