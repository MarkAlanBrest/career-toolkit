{
  "manifest_version": 3,
  "name": "Canvas Class Management Toolbars",
  "version": "2.4.0",
  "description": "Install only the Canvas management toolbars: scheduler, grader, and student messaging.",
  "permissions": [
    "storage",
    "cookies",
    "windows",
    "management"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.com/*",
    "https://*.canvaslms.com/*",
    "https://canvasenhancer.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.com/*",
        "https://*.canvaslms.com/*"
      ],
      "js": [
        "backup.js",
        "canvas-token.js",
        "entitlements.js",
        "hub.js",
        "grader.js",
        "scheduler.js",
        "email.js"
      ],
      "css": [
        "toolbar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
