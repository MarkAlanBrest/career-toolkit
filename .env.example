ANTHROPIC_API_KEY=
OWNER_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SIGNUP_ADMIN_TOKEN=

# Canvas Broadcast Center (all values are server-side only)
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=
CANVAS_ACCOUNT_ID=1
# Optional one-time bootstrap login. After first sign-in, administrators are managed in the app.
CANVAS_BROADCAST_ADMIN_EMAIL=
CANVAS_BROADCAST_ADMIN_PASSWORD=
# Required by the daily job that deletes seven-day-old Canvas announcements.
CRON_SECRET=

# OTES Action Log — Google Apps Script sync (optional)
# Paste lib/otes/gas/Code.gs into your Hubbard Apps Script project, deploy as web app
# (Execute as: Me, Anyone can access), then use the /exec URL here.
OTES_GAS_SYNC_URL=
OTES_SYNC_SECRET=


# Local job search — searches Indeed, LinkedIn, Google Jobs, ZipRecruiter via JSearch
# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free tier available)
RAPIDAPI_KEY=
# Optional: https://jooble.org/api/about
JOOBLE_API_KEY=
# USAJobs: register at https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_EMAIL=careerservices@ncstrades.edu
# Adzuna: register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Custom RSS feeds — one per line: id|label|url
# JOB_SEARCH_RSS_FEEDS=
# tribune|Example Tribune Jobs|https://example.com/jobs.rss

# LGA Room email sender fallback. A Microsoft 365 sender configured in the LGA Room
# Admin settings page takes priority. MAILJET_FROM_EMAIL must be verified in Mailjet
# (Account > Sender addresses) — no domain ownership required, just a click-to-confirm email.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# Legacy SMTP fallback. Microsoft 365 school accounts should use Microsoft Graph
# in the Admin page because Exchange Online no longer supports password-based SMTP.
OUTLOOK_USER=
OUTLOOK_APP_PASSWORD=
OUTLOOK_FROM_NAME=

# Vercel Blob — https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=

# LGA Room reservations
# Password the bottom-right admin button checks (defaults to ncstadmin123 if unset)
LGA_ROOM_ADMIN_PASSWORD=

# Employer Portal admin
# Emergency admin password (defaults to ncstadmin123 if unset)
EMPLOYER_PORTAL_ADMIN_PASSWORD=

# Student Portal — Microsoft school account sign-in
# Register a Web app in Azure AD with redirect URI:
#   https://your-domain.vercel.app/api/student-portal/auth/callback
STUDENT_PORTAL_AZURE_TENANT_ID=
STUDENT_PORTAL_AZURE_CLIENT_ID=
STUDENT_PORTAL_AZURE_CLIENT_SECRET=
STUDENT_PORTAL_ALLOWED_EMAIL_DOMAIN=ncstrades.edu

# Microsoft Graph — app-only auth for "Save to SharePoint" (Document Creator)
# One Azure AD app registration granted Sites.Selected access to a single shared SharePoint site
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
