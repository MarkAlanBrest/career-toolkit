ANTHROPIC_API_KEY=
OWNER_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SIGNUP_ADMIN_TOKEN=

NEXT_PUBLIC_APP_URL=https://career-toolkit-ruby.vercel.app

# LGA Room email sender — Mailjet (https://app.mailjet.com/account/apikeys) takes
# priority when set. MAILJET_FROM_EMAIL must be a sender verified in Mailjet
# (Account > Sender addresses) — no domain ownership required, just a click-to-confirm email.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# Fallback sender if Mailjet isn't configured — used only if no admin has set a
# sender account in the Admin settings UI (Sender account section) either.
OUTLOOK_USER=
OUTLOOK_APP_PASSWORD=
OUTLOOK_FROM_NAME=

# Vercel Blob — https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=

# LGA Room reservations
# Password the bottom-right admin button checks (defaults to ncstadmin123 if unset)
LGA_ROOM_ADMIN_PASSWORD=

# Microsoft Graph — app-only auth for "Save to SharePoint" (Document Creator)
# One Azure AD app registration granted Sites.Selected access to a single shared SharePoint site
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
