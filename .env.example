# Lemon Squeezy API key with read/write access to checkouts
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Comma-separated monthly and annual subscription variant IDs
LEMONSQUEEZY_TEACHING_VARIANT_IDS=
LEMONSQUEEZY_CREATION_VARIANT_IDS=

# One-time product variant IDs
LEMONSQUEEZY_TEACHING_REFILL_VARIANT_ID=
LEMONSQUEEZY_CREATION_REFILL_VARIANT_ID=

NEXT_PUBLIC_APP_URL=https://career-toolkit-ruby.vercel.app
NEXT_PUBLIC_LEMONSQUEEZY_TEACHING_MONTHLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_TEACHING_ANNUAL_URL=
NEXT_PUBLIC_LEMONSQUEEZY_CREATION_MONTHLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_CREATION_ANNUAL_URL=

# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=
# From address for build-a-class emails (must be a verified Resend domain, or leave blank to use onboarding@resend.dev)
RESEND_FROM_EMAIL=

# Vercel Blob — https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=

# Microsoft Graph — app-only auth for "Save to SharePoint" (Document Creator)
# One Azure AD app registration granted Sites.Selected access to a single shared SharePoint site
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
