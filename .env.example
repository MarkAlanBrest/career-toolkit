ANTHROPIC_API_KEY=
OWNER_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SIGNUP_ADMIN_TOKEN=

NEXT_PUBLIC_APP_URL=https://career-toolkit-ruby.vercel.app

# LGA Room email sender — optional fallback only. The real config lives in the
# app's Admin settings UI (Sender account section), where any admin can set their
# own email + app password without a redeploy. These vars are just a bootstrap
# default for before anyone has configured it there.
OUTLOOK_USER=
OUTLOOK_APP_PASSWORD=
OUTLOOK_FROM_NAME=

# Vercel Blob — https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=

# LGA Room reservations
# Password the bottom-right admin button checks (defaults to ncstadmin123 if unset)
LGA_ROOM_ADMIN_PASSWORD=

# Microsoft Graph — app-only auth for "Save to SharePoint" (Document Creator)
# One Azure AD app registration granted Sites.Selected access to a single shared SharePoint site
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
